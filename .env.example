# SEC EDGAR - "이름 이메일" 형식으로 입력 (필수)
EDGAR_USER_AGENT="YourName your@email.com"

# Supabase - 프로젝트 Settings > API 에서 확인
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_KEY="your-anon-or-service-role-key"

# 다운로드 경로 (기본값: /tmp/edgar)
DOWNLOAD_DIR="/tmp/edgar"

# API 서버 CORS 허용 도메인 (쉼표 구분)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# 웹 프론트엔드 (web/.env.local 에도 동일하게)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# 모바일 앱 (mobile/.env 에도 동일하게)
EXPO_PUBLIC_API_URL="http://localhost:8000"
